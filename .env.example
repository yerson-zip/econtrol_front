# Copia este archivo a .env (no se sube a Git)

# Mismo Client ID de Google que usa el backend (GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Déjalo vacío: en desarrollo Vite y en producción vercel.json redirigen /api al backend, así la cookie de sesión es del mismo origen
VITE_API_URL=
